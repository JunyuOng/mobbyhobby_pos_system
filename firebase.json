{
  "functions": [
    {
      "source": "functions",
      "codebase": "mobihobby-security",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    }
  }
}

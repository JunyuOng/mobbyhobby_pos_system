rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function enrolled() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['manager', 'cashier'];
    }
    match /events/{eventId} {
      allow read: if enrolled();
      // All writes go through commitPosEvent, including logical deletion events.
      // The callable verifies the caller and sale prices using trusted catalog data.
      allow write: if false;
    }
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Security catalog, idempotency receipts and setup state are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
